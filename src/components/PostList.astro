---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getBlogCategory } from '../data/blogCategories';

interface Props {
  posts: CollectionEntry<'blog'>[];
  showCategory: boolean;
  variant: 'home' | 'archive';
}
const {
   posts,
   showCategory = true,
   variant = 'archive',
} = Astro.props;
---
<ul class:list={['post-list', `post-list--${variant}`]}>
  {posts.map((post) => (
    <li class="post-item">
      <a class="post-link" href={`/blog/${post.id}/`}>
        <span class="post-title-group">
          <span class="post-title">{post.data.title}</span>
          <span class="post-description">{post.data.description}</span>
          {showCategory && post.data.category && <span class="post-category">{getBlogCategory(post.data.category)?.label}</span>}
        </span>
        <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
      </a>
    </li>
  ))}
</ul>
