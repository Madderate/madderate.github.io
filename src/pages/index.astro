---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { projects } from '../data/projects';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const featuredProjects = projects.filter((project) => project.featured);
---
<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="intro-section" aria-labelledby="intro-title">
    <p class="eyebrow">PERSONAL SPACE / SOFTWARE & NOTES</p>
    <h1 id="intro-title">Hi, I'm Madderate<span class="accent-dot">.</span></h1>
    <p class="intro-lead">开发软件，记录思考，保持好奇。</p>
    <p class="intro-copy">这里是我的个人主页。我会分享正在构建的项目、技术实践，以及值得记录的想法。</p>
    <div class="intro-links">
      <a class="text-link" href="/about/">了解更多 <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">Selected Projects</h2>
      <a href="/projects/">全部项目 ↗</a>
    </div>
    <ul class="project-list project-list--home">
      {featuredProjects.map((project) => (
        <li class="project-item">
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link">
            <span class="project-name">{project.name}<span class="external-mark" aria-hidden="true"> ↗</span></span>
            <span class="project-description">{project.description}</span>
            <span class="project-tags">{project.tags.join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">Recent Writing</h2>
      <a href="/blog/">所有文章 ↗</a>
    </div>
    {recentPosts.length > 0 ? <PostList posts={recentPosts} showCategory={true} variant="home" /> : <p class="empty-state">文章正在准备中。</p>}
  </section>
</SiteLayout>
